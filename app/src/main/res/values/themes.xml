<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Material Design 3 -->
    <style name="Theme.VariableFontTest" parent="@style/Theme.Material3.DayNight.NoActionBar">
        <!-- Enable edge-to-edge display -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>

        <!-- Apply MD3 preference theme with dialog styling -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <!-- MD3 dialog styling: BOTH prefixed and non-prefixed for full coverage -->
        <item name="android:dialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="dialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>


    <!-- Slider 样式覆盖：默认 MD3 Expressive（Widget.Material3.Slider），
         可在工具栏切换为 MD3 Legacy（Widget.Material3.Slider.Legacy）。 -->
    <style name="ThemeOverlay.App.Slider.Expressive" parent="">
        <item name="sliderStyle">@style/Widget.Material3.Slider</item>
    </style>

    <style name="ThemeOverlay.App.Slider.Legacy" parent="">
        <item name="sliderStyle">@style/Widget.Material3.Slider.Legacy</item>
    </style>

    <!-- MD3 dialog 选中态（RadioButton/CheckBox）改用 Primary；
         库默认 colorControlActivated=colorSecondary，此处纠正 -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorAccent">?attr/colorPrimary</item>
    </style>
</resources>
